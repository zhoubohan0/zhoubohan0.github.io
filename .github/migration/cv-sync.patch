diff --git a/.github/scripts/sync-website.sh b/.github/scripts/sync-website.sh
index 9858f6c..dc0a151 100644
--- a/.github/scripts/sync-website.sh
+++ b/.github/scripts/sync-website.sh
@@ -20 +20,5 @@ for attempt in 1 2 3; do
-  test "$(git -C "$website_dir" config -f .gitmodules --get submodule.cv.path)" = cv
+  cv_path=$(git -C "$website_dir" config -f .gitmodules --get submodule.cv.path)
+  case "$cv_path" in
+    cv|_common/cv) ;;
+    *) printf 'Unsupported CV submodule path: %s\n' "$cv_path" >&2; exit 1 ;;
+  esac
@@ -22 +26 @@ for attempt in 1 2 3; do
-  read -r mode type old_sha path < <(git -C "$website_dir" ls-tree HEAD -- cv)
+  read -r mode type old_sha path < <(git -C "$website_dir" ls-tree -r HEAD -- "$cv_path")
@@ -25 +29 @@ for attempt in 1 2 3; do
-  test "$path" = cv
+  test "$path" = "$cv_path"
@@ -32,2 +36,2 @@ for attempt in 1 2 3; do
-  git -C "$website_dir" update-index --cacheinfo "160000,$cv_sha,cv"
-  test "$(git -C "$website_dir" diff --cached --name-only)" = cv
+  git -C "$website_dir" update-index --cacheinfo "160000,$cv_sha,$cv_path"
+  test "$(git -C "$website_dir" diff --cached --name-only)" = "$cv_path"
